# =============================================================================
# Meetolog – Docker Compose environment variables
#
# Loaded by the api and worker services via env_file in docker-compose.yml.
# Hostnames (db, minio) resolve to container names on the Docker bridge
# network.
# =============================================================================

# Application
TEST_MODE=false
DEBUG=false
LLM_PROVIDER=gemini
WHISPER_MODEL=tiny

# LLM API keys (fill in for real extraction; leave blank to use mock)
GEMINI_API_KEY=
OPENAI_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://meetolog:meetolog@db:5432/meetolog

# AWS S3 / MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=meetolog-uploads
AWS_ENDPOINT_URL=http://minio:9000
AWS_PUBLIC_ENDPOINT_URL=http://localhost:9000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

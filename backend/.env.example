# =============================================================================
# Meetolog — Backend Environment Variables
#
# Copy this file to .env and fill in your values.
# For production (AWS ECS), secrets are injected via SSM Parameter Store —
# this file is for LOCAL DEVELOPMENT only.
# =============================================================================

# --- Mode -------------------------------------------------------------------
# Set to "true" to use mock services (no API keys, no ffmpeg needed)
TEST_MODE=false
DEBUG=false

# --- Database (PostgreSQL) ---------------------------------------------------
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://meetolog:meetolog@localhost:5432/meetolog

# --- AWS S3 ------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
# AWS_ENDPOINT_URL=http://localhost:9000   # Uncomment for local MinIO

# --- LLM Provider ------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Whisper (speech-to-text) ------------------------------------------------
# Model sizes: tiny, base, small, medium, large
WHISPER_MODEL=tiny

# --- Application -------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=100

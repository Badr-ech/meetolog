{
  "family": "meetolog-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::932705495489:role/meetolog-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::932705495489:role/meetolog-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "meetolog-api",
      "image": "932705495489.dkr.ecr.us-east-1.amazonaws.com/meetolog:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SERVICE_TYPE", "value": "web" },
        { "name": "PORT", "value": "8000" },
        { "name": "RUN_WORKER", "value": "false" },
        { "name": "WHISPER_MODEL", "value": "tiny" },
        { "name": "LLM_PROVIDER", "value": "gemini" },
        { "name": "TEST_MODE", "value": "false" },
        { "name": "AWS_REGION", "value": "us-east-1" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:932705495489:parameter/meetolog/DATABASE_URL"
        },
        {
          "name": "AWS_S3_BUCKET",
          "valueFrom": "arn:aws:ssm:us-east-1:932705495489:parameter/meetolog/AWS_S3_BUCKET"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:ssm:us-east-1:932705495489:parameter/meetolog/GEMINI_API_KEY"
        },
        {
          "name": "CORS_ORIGINS",
          "valueFrom": "arn:aws:ssm:us-east-1:932705495489:parameter/meetolog/CORS_ORIGINS"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/meetolog-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
